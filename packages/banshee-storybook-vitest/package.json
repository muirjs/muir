{
  "name": "@muirjs/banshee-storybook-vitest",
  "version": "0.0.0",
  "private": true,
  "description": "StrykerJS reporter for Storybook stories run through Storybook's Vitest addon: spy stubs the mock reset erases or no play checks, interaction hints and static story mutants",
  "keywords": [
    "stryker",
    "storybook",
    "vitest",
    "mutation testing",
    "reporter"
  ],
  "homepage": "https://github.com/muirjs/muir/tree/main/packages/banshee-storybook-vitest#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muirjs/muir.git",
    "directory": "packages/banshee-storybook-vitest"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@muirjs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || ^26.13.0"
  },
  "dependencies": {
    "@muirjs/moira-storybook": "0.0.0",
    "@muirjs/shadowcat-storybook": "0.0.0",
    "@stryker-mutator/api": "10.1.1"
  },
  "peerDependencies": {
    "@stryker-mutator/core": "~10.1.0"
  },
  "devDependencies": {
    "@muirjs/proteus-storybook-test": "0.0.0",
    "@storybook/addon-vitest": "10.6.5",
    "storybook": "10.6.5",
    "vitest": "5.1.0"
  },
  "nx": {
    "tags": [
      "type:lib"
    ],
    "targets": {
      "build": {
        "dependsOn": [
          "^build"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "build",
          "^typecheck"
        ]
      },
      "test": {
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production",
          "nodeVersion",
          "{workspaceRoot}/packages/moira-storybook/test/fixtures/**/*"
        ]
      },
      "lint": {
        "inputs": [
          "...",
          "{workspaceRoot}/tsconfig.base.json"
        ]
      },
      "mutate-src": {
        "inputs": [
          "default",
          "^production",
          "mutation",
          "{workspaceRoot}/packages/moira-storybook/test/fixtures/**/*"
        ]
      }
    }
  },
  "scripts": {
    "test": "node --conditions=@muirjs/source --test test/*.test.ts"
  }
}
