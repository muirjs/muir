{
  "name": "@muirjs/moira-node-test",
  "version": "0.0.0",
  "private": true,
  "description": "Adds custom mutators to the StrykerJS instrumenter, for packages of StrykerJS mutators",
  "license": "MIT",
  "keywords": [
    "stryker",
    "mutation-testing",
    "mutator"
  ],
  "homepage": "https://github.com/muirjs/muir/tree/main/packages/moira-node-test#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muirjs/muir.git",
    "directory": "packages/moira-node-test"
  },
  "bugs": {
    "url": "https://github.com/muirjs/muir/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@muirjs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --conditions=@muirjs/source --test \"test/unit/**/*.test.ts\""
  },
  "peerDependencies": {
    "@babel/core": "~8.0.0",
    "@stryker-mutator/api": "^10.1.1",
    "@stryker-mutator/core": "^10.1.1"
  },
  "devDependencies": {
    "@muirjs/madrox-node-test": "*"
  },
  "nx": {
    "tags": [
      "type:lib"
    ],
    "targets": {
      "mutate": {},
      "mutate-src": {},
      "mutate-test-code": {}
    }
  }
}
