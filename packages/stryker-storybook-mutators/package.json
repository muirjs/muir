{
  "name": "@layzee/stryker-storybook-mutators",
  "version": "0.0.0",
  "private": true,
  "description": "StrykerJS mutators for Storybook story data that story tests can kill",
  "keywords": [
    "stryker",
    "storybook",
    "mutation testing",
    "mutators",
    "args"
  ],
  "homepage": "https://github.com/LayZeeDK/lz-playwright-test/tree/main/packages/stryker-storybook-mutators#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LayZeeDK/lz-playwright-test.git",
    "directory": "packages/stryker-storybook-mutators"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@layzee/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "@stryker-mutator/core": "~10.1.0"
  },
  "dependencies": {
    "@layzee/storybook-core": "0.0.0",
    "@layzee/stryker-mutator-install": "0.0.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.9",
    "storybook": "10.6.5"
  },
  "nx": {
    "tags": [
      "type:lib"
    ],
    "targets": {
      "build": {
        "dependsOn": [
          "^build"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "build",
          "^typecheck"
        ]
      },
      "test": {
        "dependsOn": [
          "^build"
        ]
      },
      "lint": {
        "inputs": [
          "...",
          "{workspaceRoot}/tsconfig.base.json"
        ]
      }
    }
  },
  "scripts": {
    "test": "node --conditions=@layzee/source --test test/*.test.ts"
  }
}
