{
  "name": "@muirjs/moira-storybook",
  "version": "0.0.0",
  "private": true,
  "description": "Reads Storybook story files and spy stubs for the @muirjs Storybook packages",
  "keywords": [
    "storybook",
    "csf",
    "stories"
  ],
  "homepage": "https://github.com/muirjs/muir/tree/main/packages/moira-storybook#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muirjs/muir.git",
    "directory": "packages/moira-storybook"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@muirjs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@babel/parser": "7.29.11"
  },
  "peerDependencies": {
    "storybook": "^10.6.0",
    "vitest": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@storybook/addon-vitest": "10.6.5",
    "storybook": "10.6.5",
    "vitest": "5.1.0"
  },
  "nx": {
    "tags": [
      "type:lib"
    ],
    "targets": {
      "build": {
        "dependsOn": [
          "^build"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "build",
          "^typecheck"
        ]
      },
      "lint": {
        "inputs": [
          "...",
          "{workspaceRoot}/tsconfig.base.json"
        ]
      },
      "mutate-src": {}
    }
  },
  "scripts": {
    "test": "node --conditions=@muirjs/source --test test/*.test.ts"
  }
}
