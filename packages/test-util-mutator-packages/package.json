{
  "name": "@muirjs/test-util-mutator-packages",
  "version": "0.0.0",
  "private": true,
  "description": "Test support the @muirjs mutator packages share: temporary file trees and the README tier checks",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@muirjs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./compose-skips": {
      "@muirjs/source": "./src/compose-skips.ts",
      "types": "./dist/compose-skips.d.ts",
      "default": "./dist/compose-skips.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || ^26.13.0"
  },
  "dependencies": {
    "@babel/core": "8.0.9",
    "@muirjs/moira-storybook": "0.0.0",
    "storybook": "10.6.5"
  },
  "nx": {
    "tags": [
      "type:test-util"
    ],
    "targets": {
      "build": {
        "dependsOn": [
          "^build"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "build",
          "^typecheck"
        ]
      },
      "lint": {
        "inputs": [
          "...",
          "{workspaceRoot}/tsconfig.base.json"
        ]
      },
      "mutate-src": {}
    }
  },
  "scripts": {
    "test": "node --conditions=@muirjs/source --test test/*.test.ts"
  }
}
