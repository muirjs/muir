{
  "name": "@muirjs/test-util-ignorer-packages",
  "version": "0.0.0",
  "private": true,
  "description": "Test support the @muirjs ignorer packages share: ignorer outcomes through Stryker's instrumenter, and Stryker's options check",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@muirjs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "@stryker-mutator/core": "~10.1.0"
  },
  "dependencies": {
    "@muirjs/moira-mutators": "0.0.0",
    "@stryker-mutator/api": "10.1.1"
  },
  "nx": {
    "tags": [
      "type:test-util"
    ],
    "targets": {
      "build": {
        "dependsOn": [
          "^build"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "build",
          "^typecheck"
        ]
      },
      "test": {
        "dependsOn": [
          "^build"
        ]
      },
      "lint": {
        "inputs": [
          "...",
          "{workspaceRoot}/tsconfig.base.json"
        ]
      },
      "mutate-src": {}
    }
  },
  "scripts": {
    "test": "node --conditions=@muirjs/source --test test/*.test.ts"
  }
}
