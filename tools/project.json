{
  "name": "tools",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "test": {
      "command": "node --conditions=@muirjs/source --test stryker-checkpoint.test.ts",
      "options": { "cwd": "{projectRoot}" },
      "cache": true,
      "inputs": [
        "{projectRoot}/stryker-checkpoint.ts",
        "{projectRoot}/stryker-checkpoint.test.ts",
        { "externalDependencies": ["@stryker-mutator/api"] }
      ],
      "outputs": []
    },
    "lint": {
      "inputs": [
        "...",
        "{workspaceRoot}/tsconfig.tools.json",
        "{workspaceRoot}/tsconfig.node.json",
        "{workspaceRoot}/tsconfig.base.json"
      ]
    },
    "typecheck": {
      "command": "tsc -p tsconfig.tools.json",
      "options": { "cwd": "{workspaceRoot}" },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/tools/**/*.ts",
        "{workspaceRoot}/oss/**/*.ts",
        "{workspaceRoot}/stryker.*.ts",
        "{workspaceRoot}/packages/siryn-playwright/src/**/*.ts",
        "{workspaceRoot}/packages/proteus-react/src/**/*.ts",
        "{workspaceRoot}/packages/moira-mutators/src/**/*.ts",
        "{workspaceRoot}/tsconfig.tools.json",
        "{workspaceRoot}/tsconfig.node.json",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "outputs": []
    }
  }
}
