{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["type:tool"],
  "implicitDependencies": [
    "@muirjs/banshee-storybook-vitest",
    "@muirjs/madrox-node-test",
    "@muirjs/moira-mutators",
    "@muirjs/moira-storybook",
    "@muirjs/pixie-storybook-vite",
    "@muirjs/proteus-js",
    "@muirjs/proteus-msw",
    "@muirjs/proteus-node-test",
    "@muirjs/proteus-node",
    "@muirjs/proteus-playwright",
    "@muirjs/proteus-react",
    "@muirjs/proteus-storybook-test",
    "@muirjs/proteus-storybook",
    "@muirjs/shadowcat-js",
    "@muirjs/shadowcat-react",
    "@muirjs/shadowcat-storybook-vitest",
    "@muirjs/shadowcat-storybook",
    "@muirjs/shadowcat-telemetry",
    "@muirjs/siryn-node-test",
    "@muirjs/siryn-playwright"
  ],
  "targets": {
    "test": {
      "command": "node --test \"e2e/test/unit/*.test.ts\"",
      "options": { "cwd": "{workspaceRoot}" }
    },
    "oss": {
      "command": "node e2e/src/oss/main.ts",
      "options": { "cwd": "{workspaceRoot}" },
      "cache": false,
      "parallelism": false,
      "dependsOn": ["^build"]
    },
    "e2e": {
      "command": "node --test --test-concurrency=1 \"e2e/test/*.e2e.ts\"",
      "options": { "cwd": "{workspaceRoot}" },
      "cache": true,
      "parallelism": false,
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "!{projectRoot}/src/oss/**/*",
        "!{projectRoot}/test/unit/oss-*.test.ts",
        "!{projectRoot}/stryker*.config.mjs",
        "!{projectRoot}/tsconfig.stryker.json",
        "^production",
        "nodeVersion",
        "{workspaceRoot}/package.json",
        {
          "externalDependencies": [
            "@stryker-mutator/core",
            "@stryker-mutator/typescript-checker",
            "typescript",
            "@types/node"
          ]
        }
      ]
    },
    "e2e-storybook-react": {
      "command": "node --test \"e2e/test/browser/storybook-react.e2e.ts\"",
      "options": { "cwd": "{workspaceRoot}" },
      "cache": true,
      "parallelism": false,
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "!{projectRoot}/src/oss/**/*",
        "!{projectRoot}/test/unit/**/*",
        "!{projectRoot}/stryker*.config.mjs",
        "!{projectRoot}/tsconfig.stryker.json",
        "^production",
        "nodeVersion",
        "{workspaceRoot}/package.json",
        {
          "externalDependencies": [
            "@stryker-mutator/core",
            "@stryker-mutator/typescript-checker",
            "typescript",
            "@types/node"
          ]
        }
      ],
      "defaultConfiguration": "react-19",
      "configurations": {
        "react-16": { "env": { "MUIR_E2E_REACT": "16.14.0" } },
        "react-17": { "env": { "MUIR_E2E_REACT": "17.0.2" } },
        "react-18": { "env": { "MUIR_E2E_REACT": "18.3.1" } },
        "react-19": { "env": { "MUIR_E2E_REACT": "19.3.1" } }
      }
    },
    "e2e-playwright": {
      "command": "node --test \"e2e/test/browser/playwright.e2e.ts\"",
      "options": { "cwd": "{workspaceRoot}" },
      "cache": true,
      "parallelism": false,
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "!{projectRoot}/src/oss/**/*",
        "!{projectRoot}/test/unit/**/*",
        "!{projectRoot}/stryker*.config.mjs",
        "!{projectRoot}/tsconfig.stryker.json",
        "^production",
        "nodeVersion",
        "{workspaceRoot}/package.json"
      ],
      "defaultConfiguration": "stryker-10-1",
      "configurations": {
        "stryker-10-0": { "env": { "MUIR_E2E_STRYKER": "10.0.0" } },
        "stryker-10-1": { "env": { "MUIR_E2E_STRYKER": "10.1.1" } }
      }
    },
    "mutate": {},
    "mutate-src": {},
    "mutate-test-code": {}
  }
}
