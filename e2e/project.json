{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["type:tool"],
  "implicitDependencies": [
    "@muirjs/banshee-storybook-vitest",
    "@muirjs/madrox-node-test",
    "@muirjs/moira-mutators",
    "@muirjs/moira-storybook",
    "@muirjs/pixie-storybook-vite",
    "@muirjs/proteus-js",
    "@muirjs/proteus-msw",
    "@muirjs/proteus-node-test",
    "@muirjs/proteus-node",
    "@muirjs/proteus-playwright",
    "@muirjs/proteus-react",
    "@muirjs/proteus-storybook-test",
    "@muirjs/proteus-storybook",
    "@muirjs/shadowcat-js",
    "@muirjs/shadowcat-react",
    "@muirjs/shadowcat-storybook-vitest",
    "@muirjs/shadowcat-storybook",
    "@muirjs/shadowcat-telemetry",
    "@muirjs/siryn-node-test",
    "@muirjs/siryn-playwright"
  ],
  "targets": {
    "test": {
      "command": "node --test \"e2e/test/unit/*.test.ts\"",
      "options": { "cwd": "{workspaceRoot}" }
    },
    "oss": {
      "command": "node e2e/src/oss/main.ts",
      "options": { "cwd": "{workspaceRoot}" },
      "cache": false,
      "parallelism": false,
      "dependsOn": ["^build"]
    },
    "e2e": {
      "command": "node --test --test-concurrency=1 \"e2e/test/*.e2e.ts\"",
      "options": { "cwd": "{workspaceRoot}" },
      "cache": true,
      "parallelism": false,
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "!{projectRoot}/src/oss/**/*",
        "!{projectRoot}/test/unit/oss-*.test.ts",
        "!{projectRoot}/stryker*.config.mjs",
        "!{projectRoot}/tsconfig.stryker.json",
        "^production",
        "nodeVersion",
        "{workspaceRoot}/package.json",
        {
          "externalDependencies": [
            "@stryker-mutator/core",
            "@stryker-mutator/typescript-checker",
            "typescript",
            "@types/node"
          ]
        }
      ]
    },
    "mutate": {},
    "mutate-src": {},
    "mutate-test-code": {}
  }
}
