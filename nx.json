{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/test/**/*",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json"
    ],
    "sharedGlobals": [],
    "nodeVersion": [{ "runtime": "node -v" }],
    "eslintPlugins": [
      {
        "externalDependencies": [
          "eslint",
          "@nx/eslint-plugin",
          "typescript-eslint",
          "eslint-plugin-n",
          "eslint-node-test",
          "@eslint-community/eslint-plugin-eslint-comments",
          "eslint-config-prettier",
          "jsonc-eslint-parser",
          "eslint-plugin-playwright",
          "eslint-plugin-jsx-a11y",
          "eslint-plugin-react",
          "eslint-plugin-react-hooks",
          "eslint-plugin-import"
        ]
      }
    ],
    "mutation": [
      "nodeVersion",
      "{workspaceRoot}/stryker.base.mjs",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/packages/*/package.json",
      "{workspaceRoot}/packages/*/src/**/*",
      "{workspaceRoot}/tools/eslint-rules/stryker-report.ts",
      "{workspaceRoot}/tools/eslint-rules/runtime-errors.ts",
      "{workspaceRoot}/tools/eslint-rules/runtime-errors.cli.ts",
      "{workspaceRoot}/tools/eslint-rules/runtime-errors.json",
      {
        "externalDependencies": [
          "@stryker-mutator/core",
          "@stryker-mutator/typescript-checker",
          "typescript"
        ]
      }
    ]
  },
  "targetDefaults": {
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        "{workspaceRoot}/tsconfig.base.json",
        "eslintPlugins"
      ]
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^production", "nodeVersion"]
    },
    "test-integration": {
      "cache": true,
      "inputs": ["default", "^production", "nodeVersion"]
    },
    "mutate-src": {
      "executor": "nx:run-commands",
      "cache": true,
      "parallelism": false,
      "dependsOn": ["build"],
      "inputs": ["default", "^production", "mutation"],
      "outputs": [
        "{workspaceRoot}/reports/mutation/{projectName}.src.html",
        "{workspaceRoot}/reports/mutation/{projectName}.src.json"
      ],
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": [
          "node --conditions=@muirjs/source node_modules/@stryker-mutator/core/bin/stryker.js run {projectRoot}/stryker.config.mjs",
          {
            "command": "node tools/eslint-rules/runtime-errors.cli.ts reports/mutation/{projectName}.src.json",
            "forwardAllArgs": false
          }
        ]
      }
    },
    "mutate-test-code": {
      "executor": "nx:run-commands",
      "cache": true,
      "parallelism": false,
      "dependsOn": ["build"],
      "inputs": ["default", "^production", "mutation"],
      "outputs": [
        "{workspaceRoot}/reports/mutation/{projectName}.test-code.html",
        "{workspaceRoot}/reports/mutation/{projectName}.test-code.json"
      ],
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": [
          "node --conditions=@muirjs/source node_modules/@stryker-mutator/core/bin/stryker.js run {projectRoot}/stryker.test-code.config.mjs",
          {
            "command": "node tools/eslint-rules/runtime-errors.cli.ts reports/mutation/{projectName}.test-code.json",
            "forwardAllArgs": false
          }
        ]
      }
    },
    "mutate": {
      "executor": "nx:noop",
      "dependsOn": ["mutate-src", "mutate-test-code"]
    }
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "exclude": ["e2e/fixtures/**"],
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/vite/plugin",
      "options": {
        "buildTargetName": "build",
        "serveTargetName": "serve",
        "devTargetName": "dev",
        "previewTargetName": "preview",
        "serveStaticTargetName": "serve-static",
        "typecheckTargetName": "typecheck",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps"
      }
    },
    {
      "plugin": "@nx/playwright/plugin",
      "options": {
        "targetName": "e2e"
      }
    }
  ],
  "release": {
    "groups": {
      "muir": {
        "projects": ["tag:type:lib", "!@muirjs/madrox-node-test"],
        "projectsRelationship": "fixed",
        "releaseTag": {
          "pattern": "v{version}"
        }
      },
      "madrox-node-test": {
        "projects": ["@muirjs/madrox-node-test"],
        "releaseTag": {
          "pattern": "madrox-node-test@{version}"
        }
      }
    },
    "version": {
      "conventionalCommits": true,
      "preVersionCommand": "npx nx run-many -t build"
    }
  },
  "generators": {
    "@nx/react": {
      "application": {
        "babel": true,
        "style": "css",
        "linter": "eslint",
        "bundler": "vite"
      },
      "component": {
        "style": "css"
      },
      "library": {
        "style": "css",
        "linter": "eslint"
      }
    }
  }
}
